{
  "name": "bedrock-serverless-rag",
  "build": {
    "dockerfile": "Dockerfile"
  },
  "features": {
    "ghcr.io/devcontainers/features/github-cli:1": {},
    "ghcr.io/devcontainers/features/aws-cli:1": {}
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "hashicorp.terraform",
        "ms-python.python",
        "charliermarsh.ruff",
        "GitHub.vscode-pull-request-github",
        "anthropic.claude-code"
      ]
    }
  },
  "remoteUser": "vscode",
  // No host cloud credentials are mounted -- not ~/.aws (config or cached SSO
  // tokens), not any other provider's. Read-only did not help: a cached SSO
  // session is usable as-is by anything running in the container. AWS work from
  // the container goes through CI (plan.yml's read-only plan role on PRs; deploy.yml
  // behind the production Environment); `bootstrap/` and break-glass plans run on
  // the host, per README.md and the tofu-local-plan skill.
  // Do NOT add INFISICAL_*, AWS_ACCESS_KEY_ID, or any TF_VAR_ secret here as a
  // literal -- if one is ever needed, reference ${localEnv:...} so the value
  // stays on the host and is never baked into container config.
  "postCreateCommand": "git config --global --add safe.directory ${containerWorkspaceFolder} && echo 'Ready: tofu, tflint, checkov, gitleaks, zizmor, jq, yq pinned -- see .devcontainer/Dockerfile'"
}
